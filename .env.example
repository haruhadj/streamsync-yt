# ─── YouTube API ────────────────────────────────────────
# Required for YouTube Search API.
# Obtain from Google Cloud Console (YouTube Data API v3).
# You can provide multiple keys separated by commas for fallback.
YOUTUBE_API_KEY="KEY1,KEY2,KEY3"

# ─── Admin Auth ─────────────────────────────────────────
ADMIN_PASSWORD="admin"

# ─── Invidious Fallback ─────────────────────────────────
# Fallback for YouTube search if all API keys are exhausted.
INVIDIOUS_URL="http://localhost:3001"

# ─── Vercel / Frontend (build-time) ────────────────────
# Set this in Vercel Environment Variables.
# Points the frontend to your backend Socket.io server.
# Leave blank for local development (auto-detects current origin).
VITE_SOCKET_URL=""