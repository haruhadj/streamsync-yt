// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Request {
  id           String   @id @default(uuid())
  videoId      String
  title        String
  thumbnail    String?
  requesterName String   @default("anonymous")
  requesterIp  String?
  timestamp    DateTime @default(now())
  status       String   @default("pending") // pending, playing, played
  votes        Int      @default(0)
  order        Int      @default(0)
  voteRecords  Vote[]
}

model Vote {
  id        String   @id @default(uuid())
  requestId String
  ip        String
  timestamp DateTime @default(now())
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, ip])
}

model Blacklist {
  id      String @id @default(uuid())
  videoId String @unique
  reason  String?
}

model BannedIp {
  ip        String   @id
  reason    String?
  timestamp DateTime @default(now())
  expiresAt DateTime?
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SearchCache {
  query     String   @id
  results   String   // JSON stringified results
  timestamp DateTime @default(now())
}
