// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Request {
  id           String   @id @default(uuid())
  videoId      String
  title        String
  thumbnail    String?
  requesterName String   @default("anonymous")
  timestamp    DateTime @default(now())
  status       String   @default("pending") // pending, playing, played
  votes        Int      @default(0)
}

model Blacklist {
  id      String @id @default(uuid())
  videoId String @unique
  reason  String?
}

model BannedIp {
  ip        String   @id
  reason    String?
  timestamp DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
